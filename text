import os
import json
import boto3
import base64
import secrets
import string
import subprocess
import botocore.session
from botocore.signers import RequestSigner

# ================= ENV =================
REGION = os.environ["AWS_REGION"]

DB_CLUSTER_ID = os.environ["DB_INSTANCE_ID"]
SSM_PARAMETER_NAME = os.environ["SSM_PARAMETER_NAME"]
EKS_CLUSTER_NAME = os.environ["EKS_CLUSTER_NAME"]

HELM_RELEASE = os.environ["HELM_RELEASE"]
HELM_CHART = os.environ["HELM_CHART"]
HELM_NAMESPACE = os.environ["HELM_NAMESPACE"]

DEPLOYMENT_NAME = os.environ["DEPLOYMENT_NAME"]
REPLICA_COUNT = os.environ["REPLICA_COUNT"]

# ================= AWS CLIENTS =================
rds = boto3.client("rds", region_name=REGION)
ssm = boto3.client("ssm", region_name=REGION)
eks = boto3.client("eks", region_name=REGION)

# ================= HELPERS =================

def generate_password(length=32):
    """
    Aurora-safe password generator
    """
    chars = string.ascii_letters + string.digits + "!#$^*_-+=?"
    return ''.join(secrets.choice(chars) for _ in range(length))


def write_kubeconfig():
    """
    Generate kubeconfig using boto3 (no aws cli)
    """
    cluster = eks.describe_cluster(name=EKS_CLUSTER_NAME)["cluster"]
    endpoint = cluster["endpoint"]
    ca_data = cluster["certificateAuthority"]["data"]

    # Create STS token (same logic as aws eks get-token)
    session = botocore.session.get_session()
    credentials = session.get_credentials().get_frozen_credentials()

    signer = RequestSigner(
        service_id="sts",
        region_name=REGION,
        signing_name="sts",
        signature_version="v4",
        credentials=credentials,
        event_emitter=session.events
    )

    params = {
        "method": "GET",
        "url": "https://sts.amazonaws.com/?Action=GetCallerIdentity&Version=2011-06-15",
        "body": {},
        "headers": {
            "x-k8s-aws-id": EKS_CLUSTER_NAME
        },
        "context": {}
    }

    signed_url = signer.generate_presigned_url(
        params,
        region_name=REGION,
        expires_in=60
    )

    token = "k8s-aws-v1." + base64.urlsafe_b64encode(
        signed_url.encode("utf-8")
    ).decode("utf-8").rstrip("=")

    kubeconfig = f"""
apiVersion: v1
kind: Config
clusters:
- name: eks
  cluster:
    server: {endpoint}
    certificate-authority-data: {ca_data}
users:
- name: eks-user
  user:
    token: {token}
contexts:
- name: eks
  context:
    cluster: eks
    user: eks-user
current-context: eks
"""

    with open("/tmp/kubeconfig", "w") as f:
        f.write(kubeconfig)

    os.environ["KUBECONFIG"] = "/tmp/kubeconfig"


def run(cmd):
    subprocess.check_call(cmd)


# ================= LAMBDA HANDLER =================

def lambda_handler(event, context):

    # Generate new DB password
    new_password = generate_password()

    # Rotate Aurora DB password
    rds.modify_db_cluster(
        DBClusterIdentifier=DB_CLUSTER_ID,
        MasterUserPassword=new_password,
        ApplyImmediately=True
    )

    # Update SSM Parameter
    ssm.put_parameter(
        Name=SSM_PARAMETER_NAME,
        Value=new_password,
        Type="SecureString",
        Overwrite=True
    )

    # Prepare kubeconfig
    write_kubeconfig()

    # Helm upgrade with new password
    run([
        "helm", "upgrade", HELM_RELEASE, HELM_CHART,
        "-n", HELM_NAMESPACE,
        "--reuse-values",
        "--set-string", f"database.password={new_password}"
    ])

    # Scale DOWN Nexus IQ
    run([
        "kubectl", "scale", "deployment", DEPLOYMENT_NAME,
        "-n", HELM_NAMESPACE,
        "--replicas=0"
    ])

    # 7️⃣ Scale UP Nexus IQ
    run([
        "kubectl", "scale", "deployment", DEPLOYMENT_NAME,
        "-n", HELM_NAMESPACE,
        f"--replicas={REPLICA_COUNT}"
    ])

    return {
        "status": "SUCCESS",
        "message": "Aurora password rotated, SSM updated, Helm upgraded, Nexus IQ restarted"
    }
