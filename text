import os
import json
import boto3
import base64
import secrets
import string
import subprocess
import time

# ================= HARD-CODED EXPECTATIONS =================
EXPECTED_IAM_ROLE_ARN = "arn:aws:iam::077911745872:role/aws-cicm-lab-service-role-4"

# ================= ENV =================
REGION = os.environ["AWS_REGION"]
EKS_CLUSTER_NAME = os.environ["EKS_CLUSTER_NAME"]

DB_CLUSTER_ID = os.environ["DB_INSTANCE_ID"]
SSM_PARAMETER_NAME = os.environ["SSM_PARAMETER_NAME"]

DEPLOYMENT_NAME = os.environ["DEPLOYMENT_NAME"]
HELM_NAMESPACE = os.environ["HELM_NAMESPACE"]
REPLICA_COUNT = os.environ["REPLICA_COUNT"]

# ================= BIN PATHS =================
KUBECTL = "/opt/bin/kubectl"

# ================= AWS CLIENTS =================
eks = boto3.client("eks", region_name=REGION)
sts = boto3.client("sts", region_name=REGION)
rds = boto3.client("rds", region_name=REGION)
ssm = boto3.client("ssm", region_name=REGION)

# ================= HELPERS =================

def run(cmd):
    print(f"\n RUNNING: {' '.join(cmd)}")
    result = subprocess.run(
        cmd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True
    )
    print("STDOUT:\n", result.stdout)
    print("STDERR:\n", result.stderr)
    if result.returncode != 0:
        raise Exception("Command failed")

def generate_password(length=32):
    chars = string.ascii_letters + string.digits + "!#$^*_-+=?"
    return ''.join(secrets.choice(chars) for _ in range(length))

def validate_iam_role():
    identity = sts.get_caller_identity()
    print("STS IDENTITY:\n", json.dumps(identity, indent=2))

    actual_arn = identity["Arn"]
    if EXPECTED_IAM_ROLE_ARN not in actual_arn:
        raise Exception(
            f" WRONG IAM ROLE\nExpected: {EXPECTED_IAM_ROLE_ARN}\nActual: {actual_arn}"
        )

    print(" IAM ROLE VALIDATION PASSED")

def write_kubeconfig():
    cluster = eks.describe_cluster(name=EKS_CLUSTER_NAME)["cluster"]

    presigned_url = sts.generate_presigned_url(
        "get_caller_identity",
        Params={},
        ExpiresIn=60,
        HttpMethod="GET"
    )

    token = "k8s-aws-v1." + base64.urlsafe_b64encode(
        presigned_url.encode()
    ).decode().rstrip("=")

    kubeconfig = f"""
apiVersion: v1
kind: Config
clusters:
- name: eks
  cluster:
    server: {cluster["endpoint"]}
    certificate-authority-data: {cluster["certificateAuthority"]["data"]}
users:
- name: eks-user
  user:
    token: {token}
contexts:
- name: eks
  context:
    cluster: eks
    user: eks-user
current-context: eks
"""

    with open("/tmp/kubeconfig", "w") as f:
        f.write(kubeconfig)

    os.environ["KUBECONFIG"] = "/tmp/kubeconfig"
    print(" kubeconfig written")

# ================= LAMBDA HANDLER =================

def lambda_handler(event, context):

    print("\n========= START =========\n")

    #  Step 1: IAM ROLE CHECK (HARDCODED VALIDATION)
    validate_iam_role()

    #  Step 2: Write kubeconfig
    write_kubeconfig()

    #  Step 3: Prove EKS connectivity
    run([KUBECTL, "get", "--raw", "/healthz"])
    run([KUBECTL, "auth", "whoami"])
    run([KUBECTL, "get", "nodes"])

    #  Step 4: Rotate DB password
    new_password = generate_password()

    rds.modify_db_cluster(
        DBClusterIdentifier=DB_CLUSTER_ID,
        MasterUserPassword=new_password,
        ApplyImmediately=True
    )

    time.sleep(30)

    ssm.put_parameter(
        Name=SSM_PARAMETER_NAME,
        Value=new_password,
        Type="SecureString",
        Overwrite=True
    )

    # Step 5: Restart deployment
    run([
        KUBECTL, "scale", "deployment", DEPLOYMENT_NAME,
        "-n", HELM_NAMESPACE,
        "--replicas=0"
    ])

    run([
        KUBECTL, "scale", "deployment", DEPLOYMENT_NAME,
        "-n", HELM_NAMESPACE,
        f"--replicas={REPLICA_COUNT}"
    ])

    print("\n========= SUCCESS =========\n")

    return {
        "status": "SUCCESS",
        "message": "IAM validated, EKS reachable, password rotated, deployment restarted"
    }
