import base64
import secrets
import string
import subprocess
import json
import time
from botocore.signers import RequestSigner

# ================= ENV =================
REGION = os.environ["AWS_REGION"]
EKS_CLUSTER_NAME = os.environ["EKS_CLUSTER_NAME"]

# BLUE (mandatory)
BLUE_DB_CLUSTER_ID = os.environ["BLUE_DB_CLUSTER_ID"]
BLUE_SSM_PARAMETER = os.environ["BLUE_SSM_PARAMETER_NAME"]
BLUE_NAMESPACE = os.environ["BLUE_NAMESPACE"]

# GREEN (optional)
GREEN_DB_CLUSTER_ID = os.environ.get("GREEN_DB_CLUSTER_ID")
GREEN_SSM_PARAMETER = os.environ.get("GREEN_SSM_PARAMETER_NAME")
GREEN_NAMESPACE = os.environ.get("GREEN_NAMESPACE")

# Helm / K8s
HELM_RELEASE = os.environ["HELM_RELEASE"]
HELM_CHART = os.environ["HELM_CHART"]
HELM_REPO_NAME = os.environ["HELM_REPO_NAME"]
HELM_REPO_URL = os.environ["HELM_REPO_URL"]
DEPLOYMENT_NAME = os.environ["DEPLOYMENT_NAME"]
REPLICA_COUNT = os.environ["REPLICA_COUNT"]

# Ensure kubectl / helm
os.environ["PATH"] += ":/opt/bin"

# Helm writable dirs
os.environ["HELM_CACHE_HOME"] = "/tmp/helm/cache"
os.environ["HELM_CONFIG_HOME"] = "/tmp/helm/config"
os.environ["HELM_DATA_HOME"] = "/tmp/helm/data"

os.makedirs("/tmp/helm/cache", exist_ok=True)
os.makedirs("/tmp/helm/config", exist_ok=True)
os.makedirs("/tmp/helm/data", exist_ok=True)

# ================= AWS CLIENTS =================
rds = boto3.client("rds", region_name=REGION)
ssm = boto3.client("ssm", region_name=REGION)
eks = boto3.client("eks", region_name=REGION)
sts = boto3.client("sts", region_name=REGION)

# ================= HELPERS =================

def run(cmd):
    subprocess.check_call(cmd)

def generate_password(length=32):
    chars = string.ascii_letters + string.digits + "!#$^*_-+=?"
    return ''.join(secrets.choice(chars) for _ in range(length))

def setup_helm_repo():
    run(["helm", "repo", "add", HELM_REPO_NAME, HELM_REPO_URL])
    run(["helm", "repo", "update"])

def namespace_exists(namespace):
    return subprocess.call(
        ["kubectl", "get", "namespace", namespace],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL
    ) == 0

def wait_until_rds_available(cluster_id):
    while True:
        status = rds.describe_db_clusters(
            DBClusterIdentifier=cluster_id
        )["DBClusters"][0]["Status"]
        if status == "available":
            break
        time.sleep(20)

def get_eks_token(cluster_name):
    session = boto3.session.Session(region_name=REGION)
    credentials = session.get_credentials()
    sts_client = session.client("sts")

    signer = RequestSigner(
        service_id=sts_client.meta.service_model.service_id,
        region_name=REGION,
        signing_name="sts",
        signature_version="v4",
        credentials=credentials,
        event_emitter=session.events,
    )

    presigned_url = signer.generate_presigned_url(
        request_dict={
            "method": "GET",
            "url": f"https://sts.{REGION}.amazonaws.com/"
                   "?Action=GetCallerIdentity&Version=2011-06-15",
            "body": {},
            "headers": {"x-k8s-aws-id": cluster_name},
            "context": {},
        },
        operation_name="GetCallerIdentity",
        expires_in=60,
    )

    return "k8s-aws-v1." + base64.urlsafe_b64encode(
        presigned_url.encode()
    ).decode().rstrip("=")

def write_kubeconfig():
    cluster = eks.describe_cluster(name=EKS_CLUSTER_NAME)["cluster"]
    token = get_eks_token(EKS_CLUSTER_NAME)

    kubeconfig = {
        "apiVersion": "v1",
        "kind": "Config",
        "clusters": [{
            "name": "eks",
            "cluster": {
                "server": cluster["endpoint"],
                "certificate-authority-data": cluster["certificateAuthority"]["data"]
            }
        }],
        "contexts": [{
            "name": "eks",
            "context": {"cluster": "eks", "user": "lambda"}
        }],
        "current-context": "eks",
        "users": [{
            "name": "lambda",
            "user": {"token": token}
        }]
    }

    with open("/tmp/kubeconfig", "w") as f:
        json.dump(kubeconfig, f)

    os.environ["KUBECONFIG"] = "/tmp/kubeconfig"

def process_env(name, db_cluster, ssm_param, namespace):
    print(f"===== Processing {name} =====")
    # Scale DOWN
    run([
        "kubectl", "scale", "deployment", DEPLOYMENT_NAME,
        "-n", namespace,
        "--replicas=0"
    ])

    password = generate_password()

    # Rotate RDS
    rds.modify_db_cluster(
        DBClusterIdentifier=db_cluster,
        MasterUserPassword=password,
        ApplyImmediately=True
    )
    wait_until_rds_available(db_cluster)

    # Update SSM
    ssm.put_parameter(
        Name=ssm_param,
        Value=password,
        Type="SecureString",
        Overwrite=True
    )

    # Helm upgrade
    run([
        "helm", "upgrade",
        HELM_RELEASE, HELM_CHART,
        "-n", namespace,
        "--reuse-values",
        "--set-string", f"iq_server.database.password={password}"
    ])

    # Scale UP
    run([
        "kubectl", "scale", "deployment", DEPLOYMENT_NAME,
        "-n", namespace,
        f"--replicas={REPLICA_COUNT}"
    ])

    print(f"{name} completed successfully")

# ================= LAMBDA HANDLER =================

def lambda_handler(event, context):

    print("CALLER:", sts.get_caller_identity())

    write_kubeconfig()
    setup_helm_repo()
    
    #  Blue (live)
    if BLUE_NAMESPACE and namespace_exists(BLUE_NAMESPACE):
        process_env(
            name="BLUE",
            db_cluster=BLUE_DB_CLUSTER_ID,
