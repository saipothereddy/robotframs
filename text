import os
import json
import boto3
import base64
import secrets
import string
import subprocess
import time

# ================= ENV =================
REGION = os.environ["AWS_REGION"]

DB_CLUSTER_ID = os.environ["DB_INSTANCE_ID"]
SSM_PARAMETER_NAME = os.environ["SSM_PARAMETER_NAME"]
EKS_CLUSTER_NAME = os.environ["EKS_CLUSTER_NAME"]

HELM_RELEASE = os.environ["HELM_RELEASE"]
HELM_CHART = os.environ["HELM_CHART"]
HELM_NAMESPACE = os.environ["HELM_NAMESPACE"]

DEPLOYMENT_NAME = os.environ["DEPLOYMENT_NAME"]
REPLICA_COUNT = os.environ["REPLICA_COUNT"]

# ================= BIN PATHS =================
HELM = "/opt/bin/helm"
KUBECTL = "/opt/bin/kubectl"

# ================= AWS CLIENTS =================
rds = boto3.client("rds", region_name=REGION)
ssm = boto3.client("ssm", region_name=REGION)
eks = boto3.client("eks", region_name=REGION)
sts = boto3.client("sts", region_name=REGION)

# ================= HELPERS =================

def run(cmd):
    print(f"\n▶ RUNNING: {' '.join(cmd)}")
    try:
        result = subprocess.run(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            check=True
        )
        print("STDOUT:\n", result.stdout)
    except subprocess.CalledProcessError as e:
        print(" COMMAND FAILED")
        print("STDOUT:\n", e.stdout)
        print("STDERR:\n", e.stderr)
        raise


def generate_password(length=32):
    chars = string.ascii_letters + string.digits + "!#$^*_-+=?"
    return ''.join(secrets.choice(chars) for _ in range(length))


def write_kubeconfig():
    print("\n Fetching EKS cluster details")
    cluster = eks.describe_cluster(name=EKS_CLUSTER_NAME)["cluster"]

    print("EKS ENDPOINT:", cluster["endpoint"])

    print("\n Generating STS token")
    presigned_url = sts.generate_presigned_url(
        "get_caller_identity",
        Params={},
        ExpiresIn=60,
        HttpMethod="GET"
    )

    token = "k8s-aws-v1." + base64.urlsafe_b64encode(
        presigned_url.encode()
    ).decode().rstrip("=")

    kubeconfig = f"""
apiVersion: v1
kind: Config
clusters:
- name: eks
  cluster:
    server: {cluster["endpoint"]}
    certificate-authority-data: {cluster["certificateAuthority"]["data"]}
users:
- name: eks-user
  user:
    token: {token}
contexts:
- name: eks
  context:
    cluster: eks
    user: eks-user
current-context: eks
"""

    with open("/tmp/kubeconfig", "w") as f:
        f.write(kubeconfig)

    os.environ["KUBECONFIG"] = "/tmp/kubeconfig"

    print("\n KUBECONFIG written to /tmp/kubeconfig")
    print("KUBECONFIG EXISTS:", os.path.exists("/tmp/kubeconfig"))
    print("\n KUBECONFIG (TOKEN REDACTED):")
    print(kubeconfig.replace(token, "***REDACTED***"))


# ================= LAMBDA HANDLER =================

def lambda_handler(event, context):

    print("\n================ DEBUG START ================\n")

    #  STEP 1: Confirm Lambda IAM Role
    identity = sts.get_caller_identity()
    print("STS IDENTITY:\n", json.dumps(identity, indent=2))

    #  STEP 2: Confirm EKS access via API
    eks.describe_cluster(name=EKS_CLUSTER_NAME)
    print("EKS DescribeCluster: OK")

    #  STEP 3: Write kubeconfig
    write_kubeconfig()

    #  STEP 4: kubectl binary check
    run([KUBECTL, "version", "--client", "--short"])

    #  STEP 5: API reachability (NO AUTH)
    run([KUBECTL, "get", "--raw", "/healthz"])

    #  STEP 6: Authentication check
    run([KUBECTL, "auth", "whoami"])

    #  STEP 7: Full verbose debug
    run([KUBECTL, "get", "nodes", "-v=9"])

    print("\n================ EKS DEBUG PASSED ================\n")

    # ================= ACTUAL LOGIC =================

    print("\n Rotating Aurora password")
    new_password = generate_password()

    rds.modify_db_cluster(
        DBClusterIdentifier=DB_CLUSTER_ID,
        MasterUserPassword=new_password,
        ApplyImmediately=True
    )

    time.sleep(30)

    print(" Updating SSM parameter")
    ssm.put_parameter(
        Name=SSM_PARAMETER_NAME,
        Value=new_password,
        Type="SecureString",
        Overwrite=True
    )

    print("⬇ Scaling DOWN deployment")
    run([
        KUBECTL, "scale", "deployment", DEPLOYMENT_NAME,
        "-n", HELM_NAMESPACE,
        "--replicas=0"
    ])

    print("⬆ Scaling UP deployment")
    run([
        KUBECTL, "scale", "deployment", DEPLOYMENT_NAME,
        "-n", HELM_NAMESPACE,
        f"--replicas={REPLICA_COUNT}"
    ])

    print("\n================ SUCCESS ================\n")

    return {
        "status": "SUCCESS",
        "message": "EKS connectivity verified, password rotated, deployment restarted"
    }
