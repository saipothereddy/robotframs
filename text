import os
import boto3
import base64
import secrets
import string
import subprocess
import json
import yaml
from botocore.signers import RequestSigner

# ================= ENV =================
REGION = os.environ["AWS_REGION"]
DB_CLUSTER_ID = os.environ["DB_INSTANCE_ID"]
SSM_PARAMETER_NAME = os.environ["SSM_PARAMETER_NAME"]
EKS_CLUSTER_NAME = os.environ["EKS_CLUSTER_NAME"]

HELM_RELEASE = os.environ["HELM_RELEASE"]
HELM_CHART = os.environ["HELM_CHART"]
HELM_NAMESPACE = os.environ["HELM_NAMESPACE"]

HELM_REPO_NAME = os.environ["HELM_REPO_NAME"]
HELM_REPO_URL = os.environ["HELM_REPO_URL"]

DEPLOYMENT_NAME = os.environ["DEPLOYMENT_NAME"]

# Ensure kubectl / helm from Lambda Layer
os.environ["PATH"] += ":/opt/bin"

# ---- Helm writable dirs for Lambda ----
os.environ["HELM_CACHE_HOME"] = "/tmp/helm/cache"
os.environ["HELM_CONFIG_HOME"] = "/tmp/helm/config"
os.environ["HELM_DATA_HOME"] = "/tmp/helm/data"

os.makedirs("/tmp/helm/cache", exist_ok=True)
os.makedirs("/tmp/helm/config", exist_ok=True)
os.makedirs("/tmp/helm/data", exist_ok=True)

# ================= AWS CLIENTS =================
rds = boto3.client("rds", region_name=REGION)
ssm = boto3.client("ssm", region_name=REGION)
eks = boto3.client("eks", region_name=REGION)
sts = boto3.client("sts", region_name=REGION)

# ================= HELPERS =================

def run(cmd):
    return subprocess.check_output(cmd).decode("utf-8")


def setup_helm_repo():
    subprocess.check_call(["helm", "repo", "add", HELM_REPO_NAME, HELM_REPO_URL])
    subprocess.check_call(["helm", "repo", "update"])


def generate_password(length=32):
    chars = string.ascii_letters + string.digits + "!#$^*_-+=?"
    return ''.join(secrets.choice(chars) for _ in range(length))


def get_eks_token(cluster_name):
    session = boto3.session.Session(region_name=REGION)
    credentials = session.get_credentials()
    sts_client = session.client("sts")

    signer = RequestSigner(
        service_id=sts_client.meta.service_model.service_id,
        region_name=REGION,
        signing_name="sts",
        signature_version="v4",
        credentials=credentials,
        event_emitter=session.events,
    )

    request_params = {
        "method": "GET",
        "url": f"https://sts.{REGION}.amazonaws.com/?Action=GetCallerIdentity&Version=2011-06-15",
        "body": {},
        "headers": {"x-k8s-aws-id": cluster_name},
        "context": {},
    }

    presigned_url = signer.generate_presigned_url(
        request_dict=request_params,
        operation_name="GetCallerIdentity",
        expires_in=60,
    )

    return "k8s-aws-v1." + base64.urlsafe_b64encode(
        presigned_url.encode()
    ).decode().rstrip("=")


def write_kubeconfig():
    cluster = eks.describe_cluster(name=EKS_CLUSTER_NAME)["cluster"]
    token = get_eks_token(EKS_CLUSTER_NAME)

    kubeconfig = {
        "apiVersion": "v1",
        "kind": "Config",
        "clusters": [{
            "name": "eks",
            "cluster": {
                "server": cluster["endpoint"],
                "certificate-authority-data": cluster["certificateAuthority"]["data"]
            }
        }],
        "contexts": [{
            "name": "eks",
            "context": {
                "cluster": "eks",
                "user": "lambda"
            }
        }],
        "current-context": "eks",
        "users": [{
            "name": "lambda",
            "user": {"token": token}
        }]
    }

    with open("/tmp/kubeconfig", "w") as f:
        json.dump(kubeconfig, f)

    os.environ["KUBECONFIG"] = "/tmp/kubeconfig"


# ================= HELM SECRET DISCOVERY =================

def find_helm_db_secret():
    manifest = run([
        "helm", "get", "manifest", HELM_RELEASE,
        "-n", HELM_NAMESPACE
    ])

    for doc in yaml.safe_load_all(manifest):
        if not doc:
            continue

        if doc.get("kind") != "Secret":
            continue

        metadata = doc.get("metadata", {})
        name = metadata.get("name", "")
        data = doc.get("data", {})

        # Nexus IQ DB password secret (chart contract)
        if "database-password" in name and "password" in data:
            return name, "password"

        # Fallback (postgres-style)
        if "database-password" in name and "postgres-password" in data:
            return name, "postgres-password"

    raise Exception("Helm DB password secret not found")


# ================= LAMBDA HANDLER =================

def lambda_handler(event, context):

    print("CALLER:", sts.get_caller_identity())

    #  Generate new DB password
    new_password = generate_password()

    #  Rotate Aurora password
    rds.modify_db_cluster(
        DBClusterIdentifier=DB_CLUSTER_ID,
        MasterUserPassword=new_password,
        ApplyImmediately=True
    )

    #  Update SSM
    ssm.put_parameter(
        Name=SSM_PARAMETER_NAME,
        Value=new_password,
        Type="SecureString",
        Overwrite=True
    )

    #  Kubernetes access
    write_kubeconfig()
    setup_helm_repo()

    # Detect Helm DB Secret
    secret_name, secret_key = find_helm_db_secret()
    print(f"Detected Helm DB Secret: {secret_name}, key: {secret_key}")

    encoded_pw = base64.b64encode(new_password.encode()).decode()

    # Patch Secret
    subprocess.check_call([
        "kubectl", "patch", "secret", secret_name,
        "-n", HELM_NAMESPACE,
        "--type=json",
        "-p", f'[{{"op":"replace","path":"/data/{secret_key}","value":"{encoded_pw}"}}]'
    ])

    # Helm upgrade (non-secret changes only)
    subprocess.check_call([
        "helm", "upgrade", HELM_RELEASE, HELM_CHART,
        "-n", HELM_NAMESPACE,
        "--reuse-values"
    ])

    # Restart application
    subprocess.check_call([
        "kubectl", "rollout", "restart",
        "deployment", DEPLOYMENT_NAME,
        "-n", HELM_NAMESPACE
    ])

    return {
        "status": "SUCCESS",
        "message": f"Password rotated and secret {secret_name} updated"
    }
