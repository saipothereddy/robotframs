import os
import base64
import boto3
import secrets
import string
import subprocess
from botocore.signers import RequestSigner
from botocore.session import Session
import json

# ================= ENV =================
REGION = os.environ["AWS_REGION"]
DB_INSTANCE_ID = os.environ["DB_INSTANCE_ID"]
SSM_PARAMETER_NAME = os.environ["SSM_PARAMETER_NAME"]
EKS_CLUSTER_NAME = os.environ["EKS_CLUSTER_NAME"]

HELM_RELEASE = os.environ["HELM_RELEASE"]
HELM_CHART = os.environ["HELM_CHART"]
HELM_NAMESPACE = os.environ["HELM_NAMESPACE"]

DEPLOYMENT_NAME = os.environ["DEPLOYMENT_NAME"]
REPLICA_COUNT = os.environ["REPLICA_COUNT"]

# ================= AWS CLIENTS =================
rds = boto3.client("rds", region_name=REGION)
ssm = boto3.client("ssm", region_name=REGION)
eks = boto3.client("eks", region_name=REGION)

# ================= HELPERS =================

def generate_password(length=32):
    chars = string.ascii_letters + string.digits + "!@#$%^&*"
    return ''.join(secrets.choice(chars) for _ in range(length))


def write_kubeconfig():
    cluster = eks.describe_cluster(name=EKS_CLUSTER_NAME)["cluster"]

    # Get token using AWS CLI (official & stable)
    token_json = subprocess.check_output(
        [
            "aws", "eks", "get-token",
            "--cluster-name", EKS_CLUSTER_NAME,
            "--region", REGION
        ],
        text=True
    )

    token = json.loads(token_json)["status"]["token"]

    kubeconfig = f"""
apiVersion: v1
kind: Config
clusters:
- name: eks
  cluster:
    server: {cluster['endpoint']}
    certificate-authority-data: {cluster['certificateAuthority']['data']}
users:
- name: eks-user
  user:
    token: {token}
contexts:
- name: eks
  context:
    cluster: eks
    user: eks-user
current-context: eks
"""

    with open("/tmp/kubeconfig", "w") as f:
        f.write(kubeconfig)

    os.environ["KUBECONFIG"] = "/tmp/kubeconfig"


def run(cmd):
    subprocess.check_call(cmd)


# ================= LAMBDA HANDLER =================

def lambda_handler(event, context):

    # Generate new password
    new_password = generate_password()

    # Rotate password in RDS
    rds.modify_db_Cluster(
        DBClusterIdentifier=DB_INSTANCE_ID,
        MasterUserPassword=new_password,
        ApplyImmediately=True
    )

    #  Update password in SSM Parameter Store
    ssm.put_parameter(
        Name=SSM_PARAMETER_NAME,
        Value=new_password,
        Type="SecureString",
        Overwrite=True
    )

    # Prepare kubeconfig
    write_kubeconfig()

    # Helm upgrade (update DB password)
    run([
        "helm", "upgrade", HELM_RELEASE, HELM_CHART,
        "-n", HELM_NAMESPACE,
        "--reuse-values",
        "--set-string", f"database.password={new_password}"
    ])

    # Scale DOWN Nexus IQ
    run([
        "kubectl", "scale", "deployment", DEPLOYMENT_NAME,
        "-n", HELM_NAMESPACE,
        "--replicas=0"
    ])

    # Scale UP Nexus IQ
    run([
        "kubectl", "scale", "deployment", DEPLOYMENT_NAME,
        "-n", HELM_NAMESPACE,
        f"--replicas={REPLICA_COUNT}"
    ])

    return {
        "status": "SUCCESS",
        "message": "RDS password rotated, SSM updated, Helm upgraded, Nexus IQ restarted"
    }

